{
  "name": "cad-next",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "test:browser": "node --experimental-strip-types --test --test-timeout=60000 --test-concurrency=1 \"test/browser/*.browser.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "python3 ../tools/check_spec.py && npm test && npm run typecheck",
    "test:affected": "python3 ../tools/affected_tests.py --root next --run"
  },
  "dependencies": {
    "replicad": "^1.2.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
